<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottom_navigation"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:layout_gravity="bottom"
    android:background="#FFFFFF"
    android:elevation="12dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingTop="7dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/nav_map"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="지도"
            android:src="@drawable/ic_nav_map"
            android:tint="@color/bottom_nav_item_color" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="지도"
            android:textColor="@color/bottom_nav_item_color"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_report"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="제보"
            android:src="@drawable/ic_nav_report"
            android:tint="@color/bottom_nav_item_color" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="제보"
            android:textColor="@color/bottom_nav_item_color"
            android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:foregroundGravity="center"
        android:gravity="center">

        <TextView
            android:id="@+id/nav_sos"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/sos_button_background"
            android:clickable="true"
            android:contentDescription="@string/sos_accessibility_label"
            android:elevation="6dp"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/sos_label"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/nav_notifications"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="알림"
            android:src="@drawable/ic_nav_notifications"
            android:tint="@color/bottom_nav_item_color" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="알림"
            android:textColor="@color/bottom_nav_item_color"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_my"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="MY"
            android:src="@drawable/ic_nav_my"
            android:tint="@color/bottom_nav_item_color" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="MY"
            android:textColor="@color/bottom_nav_item_color"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
