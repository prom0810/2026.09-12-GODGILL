<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFBFA">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="68dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="알림"
                android:textColor="#171A19"
                android:textSize="26sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="안전 관련 소식과 이동 알림을 확인하세요."
                android:textColor="#737A77"
                android:textSize="14sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/map_panel_background"
                android:drawablePadding="12dp"
                android:elevation="2dp"
                android:padding="18dp"
                android:text="안전 경로 안내\n선택한 경로 주변의 안전시설을 확인할 수 있어요.\n\n방금 전"
                android:textColor="#343A37"
                android:textSize="14sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/map_panel_background"
                android:elevation="2dp"
                android:padding="18dp"
                android:text="제보 접수 안내\n등록한 제보는 확인 후 지도에 반영될 예정이에요.\n\n오늘"
                android:textColor="#343A37"
                android:textSize="14sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/map_panel_background"
                android:elevation="2dp"
                android:padding="18dp"
                android:text="SafeWalk에 오신 것을 환영합니다.\n안전한 이동을 위해 필요한 알림을 이곳에서 알려드릴게요.\n\n어제"
                android:textColor="#343A37"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/layout_bottom_navigation" />
</FrameLayout>
