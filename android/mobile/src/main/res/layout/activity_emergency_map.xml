<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/emergency_map_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/emergency_map_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E9EEEB">

        <TextView
            android:id="@+id/emergency_map_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="긴급 위치 지도를 불러오는 중…"
            android:textColor="#5F6663"
            android:textSize="15sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="16dp"
        android:background="@drawable/map_panel_background"
        android:elevation="10dp"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/emergency_map_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SOS 실시간 위치"
            android:textColor="#B3261E"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/emergency_map_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:accessibilityLiveRegion="polite"
            android:text="연결 준비 중…"
            android:textColor="#343A37"
            android:textSize="14sp" />

        <Button
            android:id="@+id/emergency_resolve_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#B3261E"
            android:text="상황 종료 처리"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <Button
        android:id="@+id/emergency_map_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="18dp"
        android:backgroundTint="#FFFFFF"
        android:text="돌아가기"
        android:textColor="#252A28" />
</FrameLayout>

