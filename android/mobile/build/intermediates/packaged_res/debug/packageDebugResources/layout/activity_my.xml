<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFBFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="68dp"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MY"
            android:textColor="#171A19"
            android:textSize="26sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/map_panel_background"
            android:elevation="2dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">
            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/map_filter_unchecked"
                android:contentDescription="사용자"
                android:padding="14dp"
                android:src="@drawable/ic_nav_my"
                android:tint="#737A77" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="비회원 사용자"
                android:textColor="#171A19"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="로그인하면 보호자 연결과 알림 설정을\n저장할 수 있어요."
                android:textColor="#737A77"
                android:textSize="13sp" />
            <Button
                android:id="@+id/my_login_button"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#252A28"
                android:text="로그인 또는 회원가입"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/map_panel_background"
            android:padding="18dp"
            android:text="알림 설정                                      ›"
            android:textColor="#343A37"
            android:textSize="14sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/map_panel_background"
            android:padding="18dp"
            android:text="앱 정보                                         ›"
            android:textColor="#343A37"
            android:textSize="14sp" />
    </LinearLayout>

    <include layout="@layout/layout_bottom_navigation" />
</FrameLayout>
