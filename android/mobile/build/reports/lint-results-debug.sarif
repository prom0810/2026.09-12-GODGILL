                                    "charOffset": 40,
                                    "charLength": 8368,
                                    "snippet": {
                                        "text": "<FrameLayout xmlns:android=\"http://schemas.android.com/apk/res/android\"\r\n    android:id=\"@+id/map_container\"\r\n    android:layout_width=\"match_parent\"\r\n    android:layout_height=\"match_parent\">\r\n    <ImageView\r\n        android:id=\"@+id/safemap_overlay\"\r\n        android:layout_width=\"match_parent\"\r\n        android:layout_height=\"match_parent\"\r\n        android:importantForAccessibility=\"no\"\r\n        android:scaleType=\"fitXY\"\r\n        android:visibility=\"invisible\" />\r\n    <FrameLayout\r\n        android:id=\"@+id/facility_overlay\"\r\n        android:layout_width=\"match_parent\"\r\n        android:layout_height=\"match_parent\"\r\n        android:clipChildren=\"false\"\r\n        android:visibility=\"invisible\" />\r\n    <com.safewalk.map.CctvOverlayView\r\n        android:id=\"@+id/cctv_overlay\"\r\n        android:layout_width=\"match_parent\"\r\n        android:layout_height=\"match_parent\"\r\n        android:visibility=\"invisible\" />\r\n    <com.safewalk.map.SecurityLightOverlayView\r\n        android:id=\"@+id/security_light_overlay\"\r\n        android:layout_width=\"match_parent\"\r\n        android:layout_height=\"match_parent\"\r\n        android:visibility=\"invisible\" />\r\n    <!-- 안심경로 추천: 최단/안전경로 선 + 출발/도착 마커 오버레이 -->\r\n    <com.safewalk.map.RouteOverlayView\r\n        android:id=\"@+id/route_overlay\"\r\n        android:layout_width=\"match_parent\"\r\n        android:layout_height=\"match_parent\" />\r\n\r\n    <!-- 상단: 출발지/도착지 검색만 표시. 그 아래는 지도가 그대로 보임 -->\r\n    <LinearLayout\r\n        android:layout_width=\"match_parent\"\r\n        android:layout_height=\"wrap_content\"\r\n        android:layout_gravity=\"top\"\r\n        android:orientation=\"vertical\"\r\n        android:background=\"#F2FFFFFF\"\r\n        android:padding=\"12dp\">\r\n        <LinearLayout\r\n            android:layout_width=\"match_parent\"\r\n            android:layout_height=\"wrap_content\"\r\n            android:orientation=\"horizontal\">\r\n            <EditText\r\n                android:id=\"@+id/route_start_query\"\r\n                android:layout_width=\"0dp\"\r\n                android:layout_weight=\"1\"\r\n                android:layout_height=\"wrap_content\"\r\n                android:minHeight=\"44dp\"\r\n                android:hint=\"출발지 검색\"\r\n                android:inputType=\"text\"\r\n                android:imeOptions=\"actionSearch\"\r\n                android:maxLength=\"100\"\r\n                android:singleLine=\"true\" />\r\n            <Button\r\n                android:id=\"@+id/route_start_button\"\r\n                android:layout_width=\"wrap_content\"\r\n                android:layout_height=\"wrap_content\"\r\n                android:text=\"출발지 설정\" />\r\n        </LinearLayout>\r\n        <LinearLayout\r\n            android:layout_width=\"match_parent\"\r\n            android:layout_height=\"wrap_content\"\r\n            android:layout_marginTop=\"4dp\"\r\n            android:orientation=\"horizontal\">\r\n            <EditText\r\n                android:id=\"@+id/route_end_query\"\r\n                android:layout_width=\"0dp\"\r\n                android:layout_weight=\"1\"\r\n                android:layout_height=\"wrap_content\"\r\n                android:minHeight=\"44dp\"\r\n                android:hint=\"도착지 검색\"\r\n                android:inputType=\"text\"\r\n                android:imeOptions=\"actionSearch\"\r\n                android:maxLength=\"100\"\r\n                android:singleLine=\"true\" />\r\n            <Button\r\n                android:id=\"@+id/route_end_button\"\r\n                android:layout_width=\"wrap_content\"\r\n                android:layout_height=\"wrap_content\"\r\n                android:text=\"도착지 설정\" />\r\n        </LinearLayout>\r\n\r\n        <!-- 카테고리별 표시 켜기/끄기 -->\r\n        <HorizontalScrollView\r\n            android:layout_width=\"match_parent\"\r\n            android:layout_height=\"wrap_content\"\r\n            android:layout_marginTop=\"4dp\"\r\n            android:scrollbars=\"none\">\r\n            <LinearLayout\r\n                android:layout_width=\"wrap_content\"\r\n                android:layout_height=\"wrap_content\"\r\n                android:orientation=\"horizontal\">\r\n                <CheckBox\r\n                    android:id=\"@+id/toggle_facilities\"\r\n                    android:layout_width=\"wrap_content\"\r\n                    android:layout_height=\"wrap_content\"\r\n                    android:checked=\"true\"\r\n                    android:text=\"@string/layer_facilities\" />\r\n                <CheckBox\r\n                    android:id=\"@+id/toggle_cctv\"\r\n                    android:layout_width=\"wrap_content\"\r\n                    android:layout_height=\"wrap_content\"\r\n                    android:checked=\"true\"\r\n                    android:text=\"@string/layer_cctv\" />\r\n                <CheckBox\r\n                    android:id=\"@+id/toggle_security_lights\"\r\n                    android:layout_width=\"wrap_content\"\r\n                    android:layout_height=\"wrap_content\"\r\n                    android:checked=\"true\"\r\n                    android:text=\"@string/layer_security_lights\" />\r\n                <CheckBox\r\n                    android:id=\"@+id/toggle_safemap\"\r\n                    android:layout_width=\"wrap_content\"\r\n                    android:layout_height=\"wrap_content\"\r\n                    android:checked=\"true\"\r\n                    android:text=\"생활안전지도\" />\r\n            </LinearLayout>\r\n        </HorizontalScrollView>\r\n    </LinearLayout>\r\n\r\n    <!-- 하단: 최단경로/안전경로/초기화 버튼 + 결과 텍스트 -->\r\n    <LinearLayout\r\n        android:layout_width=\"match_parent\"\r\n        android:layout_height=\"wrap_content\"\r\n        android:layout_gravity=\"bottom\"\r\n        android:orientation=\"vertical\"\r\n        android:background=\"#F2FFFFFF\"\r\n        android:padding=\"12dp\">\r\n        <LinearLayout\r\n            android:layout_width=\"match_parent\"\r\n            android:layout_height=\"wrap_content\"\r\n            android:orientation=\"horizontal\">\r\n            <Button\r\n                android:id=\"@+id/route_shortest_button\"\r\n                android:layout_width=\"0dp\"\r\n                android:layout_weight=\"1\"\r\n                android:layout_height=\"wrap_content\"\r\n                android:text=\"최단경로\" />\r\n            <Button\r\n                android:id=\"@+id/route_safe_button\"\r\n                android:layout_width=\"0dp\"\r\n                android:layout_weight=\"1\"\r\n                android:layout_height=\"wrap_content\"\r\n                android:text=\"안전경로\" />\r\n            <Button\r\n                android:id=\"@+id/route_reset_button\"\r\n                android:layout_width=\"0dp\"\r\n                android:layout_weight=\"1\"\r\n                android:layout_height=\"wrap_content\"\r\n                android:text=\"초기화\" />\r\n        </LinearLayout>\r\n        <TextView\r\n            android:id=\"@+id/route_result_text\"\r\n            android:layout_width=\"match_parent\"\r\n            android:layout_height=\"wrap_content\"\r\n            android:layout_marginTop=\"4dp\"\r\n            android:accessibilityLiveRegion=\"polite\"\r\n            android:textColor=\"#202124\" />\r\n    </LinearLayout>\r\n\r\n    <!-- 기존 장소검색/레이어 토글/검색결과 UI: 화면에는 숨기되, MapActivity.kt가\r\n         findViewById로 참조하므로 뷰 자체는 남겨둔다 (완전히 지우면 앱이 튕김) -->\r\n    <LinearLayout\r\n        android:visibility=\"gone\"\r\n        android:layout_width=\"match_parent\"\r\n        android:layout_height=\"wrap_content\">\r\n        <EditText\r\n            android:id=\"@+id/search_query\"\r\n            android:layout_width=\"wrap_content\"\r\n            android:layout_height=\"wrap_content\"\r\n            android:hint=\"@string/search_hint\" />\r\n        <Button\r\n            android:id=\"@+id/search_button\"\r\n            android:layout_width=\"wrap_content\"\r\n            android:layout_height=\"wrap_content\"\r\n            android:text=\"@string/search_button\" />\r\n        <TextView\r\n            android:id=\"@+id/search_status\"\r\n            android:layout_width=\"wrap_content\"\r\n            android:layout_height=\"wrap_content\" />\r\n        <ListView\r\n            android:id=\"@+id/search_results\"\r\n            android:layout_width=\"wrap_content\"\r\n            android:layout_height=\"wrap_content\" />\r\n    </LinearLayout>\r\n\r\n    <TextView\r\n        android:id=\"@+id/map_status\"\r\n        android:layout_width=\"match_parent\"\r\n        android:layout_height=\"wrap_content\"\r\n        android:layout_gravity=\"center\"\r\n        android:background=\"#F2FFFFFF\"\r\n        android:gravity=\"center\"\r\n        android:padding=\"24dp\"\r\n        android:text=\"@string/map_loading\"\r\n        android:textColor=\"#202124\"\r\n        android:textSize=\"16sp\"\r\n        android:accessibilityLiveRegion=\"polite\" />\r\n</FrameLayout>"
                                    }
                                },
