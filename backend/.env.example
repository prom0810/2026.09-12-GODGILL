# 실제 값은 절대 커밋하지 말 것. 이 파일은 어떤 값이 필요한지 보여주는 예시일 뿐이며,
# Spring Boot가 이 파일을 자동으로 읽지는 않는다. (자세한 설정 방법은 README.md 참고)

# Supabase Dashboard → 프로젝트 → Connect → Session pooler → View parameters 에서 확인
DB_URL=jdbc:postgresql://YOUR_PROJECT_REF.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_DB_PASSWORD

# 생략 시 8080
SERVER_PORT=8080

# 로그인/회원가입 JWT 서명 키. 생략하면 application.yml의 로컬 개발용 기본값이 쓰인다.
# 팀에서 공유하는 값으로 통일하거나(그래야 서버를 재시작해도 발급된 토큰이 유효), 각자 다르게 둬도
# 개발 단계에서는 무방하다. 운영 배포 전에는 반드시 충분히 긴 랜덤 값으로 교체할 것.
JWT_SECRET=change-me-to-a-long-random-string-before-sharing-or-deploying

# ── 제보 사진 저장소 ──
# supabase: Supabase Storage 사용 / local 또는 생략: 개발용으로 backend/local-storage 폴더에 저장
STORAGE_TYPE=supabase

# Supabase Dashboard → Storage → Settings(S3 Configuration) 에서 확인/발급.
# Access Key는 모든 버킷에 접근 가능한 서버 전용 키다. Android 코드나 채팅방에 올리지 말 것.
STORAGE_ENDPOINT=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
STORAGE_REGION=YOUR_REGION
STORAGE_ACCESS_KEY=YOUR_ACCESS_KEY_ID
STORAGE_SECRET_KEY=YOUR_SECRET_ACCESS_KEY
STORAGE_BUCKET=risk-report-images

# (선택) 사진 열람 URL 유효 시간(분). 생략 시 10
# STORAGE_SIGNED_URL_TTL_MINUTES=10

# ── 푸시 알림 (FCM) ──
# Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성 으로 받은 JSON 파일의 경로.
# 상대 경로는 backend 폴더 기준. 이 파일은 프로젝트 관리자 권한 키이므로 절대 커밋하지 말 것
# (backend/firebase-service-account.json 은 .gitignore에 등록되어 있음).
# 생략하면 푸시를 실제로 보내지 않고 서버 로그에만 출력한다.
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json

# (개발용) POST /api/dev/push-test 활성화. 운영 배포에서는 넣지 말 것. 생략 시 false
DEV_PUSH_TEST_ENABLED=true
