### ── 대표 보호자 · 보호자 수정 (DB v3 반영) ───────────────────────────
### 이 시점 미성년자 보호자: kidGuardian1(김엄마) 1명. 가입 때 첫 보호자라 자동으로 대표다.

### 21. 남은 보호자가 대표인지 + 새 필드 확인 → isPrimary=true, UNREGISTERED
GET {{host}}/api/guardians
Authorization: Bearer {{kidToken}}

> {%
    client.test("대표 자동 지정 · 새 필드", () => {
        const g = response.body.data[0];
        client.assert(g.isPrimary === true, "isPrimary=" + g.isPrimary);
        client.assert(g.registrationStatus === "UNREGISTERED", "status=" + g.registrationStatus);
        client.assert(g.canViewLocation === false, "canViewLocation=" + g.canViewLocation);
        client.assert(g.connectedAt === null, "connectedAt=" + g.connectedAt);
    });
%}

### 22. 대표로 지정하며 추가 → 200, 새 보호자가 대표
POST {{host}}/api/guardians
Authorization: Bearer {{kidToken}}
Content-Type: application/json

{
  "name": "김아빠",
  "phone": "010-8888-{{run}}",
  "relationship": "PARENT",
  "isPrimary": true,
  "canViewLocation": true
}

> {%
    client.test("대표로 추가", () => {
        client.assert(response.status === 200, "status=" + response.status);
        client.assert(response.body.data.isPrimary === true, "isPrimary=" + response.body.data.isPrimary);
        client.assert(response.body.data.canViewLocation === true, "canViewLocation");
    });
    client.global.set("kidGuardian3", response.body.data.guardianId);
%}

### 23. 목록: 대표는 1명뿐 (김엄마는 해제됨)
GET {{host}}/api/guardians
Authorization: Bearer {{kidToken}}

> {%
    client.test("대표 1명", () => {
        const primaries = response.body.data.filter(g => g.isPrimary);
        client.assert(primaries.length === 1, "primary count=" + primaries.length);
        client.assert(primaries[0].name === "김아빠", "primary=" + primaries[0].name);
    });
%}

### 24. 수정: 이름·위치 열람 변경 + 김엄마를 다시 대표로 → 200
PATCH {{host}}/api/guardians/{{kidGuardian1}}
Authorization: Bearer {{kidToken}}
Content-Type: application/json

{
  "name": "엄마",
  "isPrimary": true,
  "canViewLocation": true
}

> {%
    client.test("보호자 수정", () => {
        client.assert(response.status === 200, "status=" + response.status);
        client.assert(response.body.data.name === "엄마", "name=" + response.body.data.name);
        client.assert(response.body.data.isPrimary === true, "isPrimary");
        client.assert(response.body.data.relationship === "PARENT", "생략한 relationship은 그대로");
    });
%}

### 25. 대표 보호자를 직접 해제 → 400
PATCH {{host}}/api/guardians/{{kidGuardian1}}
Authorization: Bearer {{kidToken}}
Content-Type: application/json

{ "isPrimary": false }

> {% client.test("대표 해제 거부", () => client.assert(response.status === 400, "status=" + response.status)); %}

