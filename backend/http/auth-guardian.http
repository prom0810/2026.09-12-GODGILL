### ─────────────────────────────────────────────────────────────────────
### 회원가입 · JWT 인증 · 보호자 API 테스트 (IntelliJ HTTP Client)
###
### 사용법
###  1. 백엔드 실행 (bootRun)
###  2. 위에서부터 순서대로 각 요청 왼쪽의 ▶ 버튼 클릭
###     (로그인/가입 응답의 토큰이 자동으로 저장되어 다음 요청에 쓰인다)
###  3. 다시 처음부터 실행할 때는 아래 @run 값을 바꾼다
###     (이메일·전화번호가 이미 가입돼 있으면 409가 나기 때문)
###
### 공통 응답 형식: { "success": true/false, "data": ..., "message": ... }
### relationship 값: PARENT(부모) / FAMILY(가족) / ACQUAINTANCE(지인)
### ─────────────────────────────────────────────────────────────────────

@host = http://localhost:8080
@run = 1001

### 1. 성인 가입 (보호자 없음) → 200
POST {{host}}/api/auth/signup
Content-Type: application/json

{
  "email": "adult{{run}}@test.com",
  "password": "1234",
  "name": "이성인",
  "phone": "010-1111-{{run}}",
  "userType": "ADULT"
}

> {%
    client.test("성인 가입 성공", () => client.assert(response.status === 200, "status=" + response.status));
    client.global.set("adultToken", response.body.data.accessToken);
%}

### 2. 미성년자 가입 (보호자 포함, 전화번호 형식 제각각) → 200
POST {{host}}/api/auth/signup
Content-Type: application/json

{
  "email": "kid{{run}}@test.com",
  "password": "1234",
  "name": "김안심",
  "phone": "0102222{{run}}",
  "userType": "MINOR",
  "guardians": [
    { "name": "김엄마", "phone": "010 3333 {{run}}", "relationship": "PARENT" },
    { "name": "김삼촌", "phone": "010.4444.{{run}}", "relationship": "가족" }
  ]
}

> {%
    client.test("미성년자 가입 성공", () => client.assert(response.status === 200, "status=" + response.status));
    client.global.set("kidToken", response.body.data.accessToken);
%}

### 3. 미성년자 가입 (보호자 없음) → 400
POST {{host}}/api/auth/signup
Content-Type: application/json

{
  "email": "kid-noguardian{{run}}@test.com",
  "password": "1234",
  "name": "박미성",
  "phone": "010-5555-{{run}}",
  "userType": "MINOR"
}

> {% client.test("보호자 없는 미성년자 거부", () => client.assert(response.status === 400, "status=" + response.status)); %}

### 4. 전화번호 중복 가입 (1번과 같은 번호, 형식만 다름) → 409
POST {{host}}/api/auth/signup
Content-Type: application/json

{
  "email": "dup{{run}}@test.com",
  "password": "1234",
  "name": "중복",
  "phone": "0101111{{run}}",
  "userType": "ADULT"
}

> {% client.test("전화번호 중복 거부", () => client.assert(response.status === 409, "status=" + response.status)); %}

### 5. 로그인 (성인) → 200, 토큰 저장
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "adult{{run}}@test.com",
  "password": "1234"
}

> {%
    client.test("로그인 성공", () => client.assert(response.status === 200, "status=" + response.status));
    client.global.set("adultToken", response.body.data.accessToken);
%}

### 6. 보호자 등록 (성인, 토큰 사용) → 200
POST {{host}}/api/guardians
Authorization: Bearer {{adultToken}}
Content-Type: application/json

{
  "name": "이친구",
  "phone": "010-6666-{{run}}",
  "relationship": "ACQUAINTANCE"
}

> {%
    client.test("보호자 등록 성공", () => client.assert(response.status === 200, "status=" + response.status));
    client.global.set("adultGuardianId", response.body.data.guardianId);
%}

### 7. 보호자 목록 조회 (성인) → 200, 1명
GET {{host}}/api/guardians
Authorization: Bearer {{adultToken}}

> {%
    client.test("보호자 목록 조회", () => {
        client.assert(response.status === 200, "status=" + response.status);
        client.assert(response.body.data.length === 1, "count=" + response.body.data.length);
    });
%}

### 7-1. 보호자 목록 조회 (미성년자) → 200, 2명 (가입 때 함께 저장된 것)
GET {{host}}/api/guardians
Authorization: Bearer {{kidToken}}

> {%
    client.test("가입 시 보호자 저장 확인", () => {
        client.assert(response.status === 200, "status=" + response.status);
        client.assert(response.body.data.length === 2, "count=" + response.body.data.length);
    });
    client.global.set("kidGuardian1", response.body.data[0].guardianId);
    client.global.set("kidGuardian2", response.body.data[1].guardianId);
%}

### 7-2. 내 정보 조회 → 200 (비밀번호 미포함)
GET {{host}}/api/users/me
Authorization: Bearer {{kidToken}}

> {%
    client.test("내 정보 조회", () => {
        client.assert(response.status === 200, "status=" + response.status);
        client.assert(response.body.data.password === undefined, "password가 응답에 포함됨");
    });
%}

### 7-3. 잘못된 관계 값 → 400
POST {{host}}/api/guardians
Authorization: Bearer {{adultToken}}
Content-Type: application/json

{
  "name": "이웃",
  "phone": "010-7777-{{run}}",
  "relationship": "NEIGHBOR"
}

> {% client.test("잘못된 관계 거부", () => client.assert(response.status === 400, "status=" + response.status)); %}

### 7-4. 같은 보호자 중복 등록 (6번과 같은 번호) → 409
POST {{host}}/api/guardians
Authorization: Bearer {{adultToken}}
Content-Type: application/json

{
  "name": "이친구",
  "phone": "0106666{{run}}",
  "relationship": "ACQUAINTANCE"
}

> {% client.test("보호자 중복 거부", () => client.assert(response.status === 409, "status=" + response.status)); %}

### 8. 토큰 없이 보호자 조회 → 401
GET {{host}}/api/guardians

> {% client.test("토큰 없음 거부", () => client.assert(response.status === 401, "status=" + response.status)); %}

### 9. 위조된 토큰으로 조회 → 401
GET {{host}}/api/guardians
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxIn0.forged-signature

> {% client.test("위조 토큰 거부", () => client.assert(response.status === 401, "status=" + response.status)); %}

### 10. 토큰 없이 다른 API 호출 (전체 적용 확인) → 401
GET {{host}}/api/routes/safe

> {% client.test("전체 API 토큰 검사", () => client.assert(response.status === 401, "status=" + response.status)); %}

### ── 보호자 삭제 ──────────────────────────────────────────────────────

### 11. 성인: 보호자 삭제 (마지막 1명도 삭제 가능) → 200
DELETE {{host}}/api/guardians/{{adultGuardianId}}
Authorization: Bearer {{adultToken}}

> {% client.test("성인 보호자 삭제", () => client.assert(response.status === 200, "status=" + response.status)); %}

### 12. 삭제 후 목록 → 0명
GET {{host}}/api/guardians
Authorization: Bearer {{adultToken}}

> {% client.test("삭제 후 0명", () => client.assert(response.body.data.length === 0, "count=" + response.body.data.length)); %}

### 13. 이미 삭제된 보호자 다시 삭제 → 404
DELETE {{host}}/api/guardians/{{adultGuardianId}}
Authorization: Bearer {{adultToken}}

> {% client.test("이미 삭제된 보호자 거부", () => client.assert(response.status === 404, "status=" + response.status)); %}

### 14. 삭제한 번호로 다시 등록 → 200
POST {{host}}/api/guardians
Authorization: Bearer {{adultToken}}
Content-Type: application/json

{
  "name": "이친구",
  "phone": "010-6666-{{run}}",
  "relationship": "ACQUAINTANCE"
}

> {% client.test("삭제한 번호 재등록", () => client.assert(response.status === 200, "status=" + response.status)); %}

### 15. 다른 사용자의 보호자 삭제 → 404
DELETE {{host}}/api/guardians/{{kidGuardian2}}
Authorization: Bearer {{adultToken}}

> {% client.test("남의 보호자 삭제 거부", () => client.assert(response.status === 404, "status=" + response.status)); %}

### 16. 미성년자: 2명 중 1명 삭제 → 200
DELETE {{host}}/api/guardians/{{kidGuardian2}}
Authorization: Bearer {{kidToken}}

> {% client.test("미성년자 보호자 삭제", () => client.assert(response.status === 200, "status=" + response.status)); %}

### 17. 미성년자: 마지막 1명 삭제 → 400
DELETE {{host}}/api/guardians/{{kidGuardian1}}
Authorization: Bearer {{kidToken}}

> {% client.test("마지막 보호자 삭제 거부", () => client.assert(response.status === 400, "status=" + response.status)); %}

### 18. 미성년자 목록 → 1명 유지
GET {{host}}/api/guardians
Authorization: Bearer {{kidToken}}

> {% client.test("1명 유지", () => client.assert(response.body.data.length === 1, "count=" + response.body.data.length)); %}

### 19. 잘못된 ID 형식 → 400
DELETE {{host}}/api/guardians/abc
Authorization: Bearer {{kidToken}}

> {% client.test("잘못된 ID 거부", () => client.assert(response.status === 400, "status=" + response.status)); %}

### 20. 토큰 없이 삭제 → 401
DELETE {{host}}/api/guardians/{{kidGuardian1}}

> {% client.test("토큰 없이 삭제 거부", () => client.assert(response.status === 401, "status=" + response.status)); %}
